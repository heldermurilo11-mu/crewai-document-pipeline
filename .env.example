GEMINI_API_KEY=your_gemini_api_key
DRIVE_FOLDER_ID=your_google_drive_folder_id
SAMPLE_CODE_PREFIXES=

# Models
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# Pipeline Runtime & Budgets
PIPELINE_MODE=crew
PIPELINE_STATE_DIR=state
PIPELINE_OUTPUT_CSV=output/resultado_crew.csv
BATCH_BUDGET_SECONDS=1500
FILE_BUDGET_SECONDS=600
WORKER_KILL_GRACE_SECONDS=5
FINALIZE_RESERVE_SECONDS=60
SUPERVISOR_GRACE_SECONDS=60
TERMINATION_GRACE_SECONDS=10
RETRY_COOLDOWN_SECONDS=300
GEMINI_REQUEST_TIMEOUT_MS=900000
EXTRACTION_MAX_ATTEMPTS=2
MAX_DOCUMENT_ATTEMPTS=3
DRIVE_REQUEST_TIMEOUT_SECONDS=120
ORIENTATION_ENABLED=true
STREAMING_ENABLED=true
DRY_RUN=false
MOVE_DRIVE_FILES=true
ALLOW_INTERACTIVE_AUTH=true
